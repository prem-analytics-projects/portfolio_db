INSERT INTO auth.user_roles (user_id, role_id)
SELECT
    u.user_id,
    r.role_id
FROM auth.users u
CROSS JOIN auth.roles r
WHERE u.email = 'your-email@example.com'
AND r.role_name = 'ADMIN';
